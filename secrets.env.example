# vigil gizli ayarları — bu dosyayı "secrets.env" olarak kopyala ve doldur.
# secrets.env git'e ASLA işlenmez (.gitignore'da).

# Telegram botu: @BotFather ile yeni bot aç, verdiği token'ı yapıştır.
TELEGRAM_BOT_TOKEN=

# Chat ID: bota kendinden bir mesaj at, sonra şunu çalıştır:
#   python3 -c "import urllib.request,json; d=json.load(urllib.request.urlopen('https://api.telegram.org/bot<TOKEN>/getUpdates')); print(d['result'][0]['message']['chat']['id'])"
TELEGRAM_CHAT_ID=

# Kamera RTSP kimlik bilgileri — cameras.json'a YAZILMAZ, buradan eklenir.
RTSP_USER=
RTSP_PASS=

# Ollama (varsayılanlar çoğu kurulum için yeterli)
OLLAMA_HOST=http://localhost:11434
AMELE_MODEL=qwen3-vl
