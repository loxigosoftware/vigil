# vigil secret settings — copy this file to "secrets.env" and fill it in.
# secrets.env is NEVER committed to git (.gitignore).

# --- Provider: local or online (single switch) ---
# PROVIDER_TYPE=openai (default) — any OpenAI-compatible endpoint:
#     local Ollama  -> BASE_URL=http://localhost:11434/v1, API_KEY empty
#     OpenAI        -> BASE_URL=https://api.openai.com/v1
#     OpenRouter    -> BASE_URL=https://openrouter.ai/api/v1
# PROVIDER_TYPE=anthropic — native Anthropic Messages API:
#     BASE_URL=https://api.anthropic.com (must NOT end with /v1)
PROVIDER_TYPE=openai
BASE_URL=http://localhost:11434/v1
API_KEY=                  # online providers only; empty for local Ollama

# Model for the agent loop. Local default qwen3-vl; online e.g. gpt-4.1-mini,
# openai/gpt-4o-mini (OpenRouter) or claude-3-5-sonnet (Anthropic).
AMELE_MODEL=qwen3-vl
# VISION_MODEL=           # optional: separate model for image analysis (defaults to AMELE_MODEL)
# VISION_MODE=auto        # auto | ollama | openai | anthropic (auto: localhost -> Ollama)
# VISION_TILES=2          # grid re-check for small/distant objects: 0=off (full frame only),
#                         # 2=2x2 tiles (default), 3=3x3 tiles — used when the full frame says Clear/Unclear

# --- Telegram ---
# Telegram bot: create one with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Chat ID: message your bot once, then run:
#   python3 -c "import urllib.request,json; d=json.load(urllib.request.urlopen('https://api.telegram.org/bot<TOKEN>/getUpdates')); print(d['result'][0]['message']['chat']['id'])"
TELEGRAM_CHAT_ID=

# --- Cameras ---
# Camera RTSP credentials — NOT stored in cameras.json, injected from here.
RTSP_USER=
RTSP_PASS=
